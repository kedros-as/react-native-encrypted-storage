{
  "name": "react-native-encrypted-storage",
  "version": "4.0.2",
  "description": "A React Native wrapper over SharedPreferences and Keychain to provide a secure alternative to Async Storage",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "react-native-encrypted-storage.podspec",
    "!android/build",
    "!android/.idea",
    "!android/.gradle",
    "!android/.settings",
    "!android/local.properties",
    "!ios/build",
    "!**/__mocks__",
    "!**/*.test.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-encrypted-storage-example",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "pods": "cd example && pod-install --quiet"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/kedros-as/react-native-encrypted-storage",
  "author": "emeraldsanto <yanick.belanger@yahoo.com> (https://github.com/emeraldsanto)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kedros-as/react-native-encrypted-storage/issues"
  },
  "homepage": "https://github.com/kedros-as/react-native-encrypted-storage#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "pod-install": "^0.3.9",
    "prettier": "^3.9.5",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "codegenConfig": {
    "name": "RNEncryptedStorageSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.emeraldsanto.encryptedstorage"
    },
    "ios": {
      "modulesProvider": {
        "RNEncryptedStorage": "RNEncryptedStorage"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
